{
  "type": "record",
  "name": "UserCreated",
  "namespace": "tech.devcoffee.integration.events.user",
  "doc": "Emitted when a user is created.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique identifier of the event (uuid)"
    },
    {
      "name": "event_version",
      "type": "int",
      "default": 1,
      "doc": "Schema version used by this event."
    },
    {
      "name": "trace_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Trace identifier for distributed tracing (uuid)"
    },
    {
      "name": "event_name",
      "type": "string",
      "default": "user.created",
      "doc": "The name of the event"
    },
    {
      "name": "event_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "When the user was created"
    },
    {
      "name": "producer",
      "type": "string",
      "doc": "Service that produced the event"
    },
    {
      "name": "data",
      "doc": "Event payload data",
      "type": {
        "type": "record",
        "name": "UserCreatedData",
        "fields": [
          {
            "name": "user",
            "type": {
              "type": "record",
              "name": "CreatedUser",
              "doc": "Full snapshot of the created user",
              "fields": [
                {
                  "name": "id",
                  "type": "string",
                  "doc": "User's unique identifier (uuid)"
                },
                {
                  "name": "email",
                  "type": "string",
                  "doc": "User's email"
                },
                {
                  "name": "firstName",
                  "type": [
                    "null",
                    "string"
                  ],
                  "default": null,
                  "doc": "User's first name"
                },
                {
                  "name": "lastName",
                  "type": [
                    "null",
                    "string"
                  ],
                  "default": null,
                  "doc": "User's last name"
                },
                {
                  "name": "language",
                  "type": [
                    "null",
                    "string"
                  ],
                  "default": null,
                  "doc": "User's language"
                },
                {
                  "name": "timezone",
                  "type": [
                    "null",
                    "string"
                  ],
                  "default": null,
                  "doc": "User's timezone"
                },
                {
                  "name": "isActive",
                  "type": "boolean",
                  "doc": "Whether the user is active"
                },
                {
                  "name": "dateJoined",
                  "type": {
                    "type": "long",
                    "logicalType": "timestamp-millis"
                  },
                  "doc": "User's joined date"
                },
                {
                  "name": "createdAt",
                  "type": {
                    "type": "long",
                    "logicalType": "timestamp-millis"
                  },
                  "doc": "When the user was created"
                },
                {
                  "name": "updatedAt",
                  "type": {
                    "type": "long",
                    "logicalType": "timestamp-millis"
                  },
                  "doc": "When the user was last updated"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
