{
  "type": "record",
  "name": "UserPasswordChanged",
  "namespace": "tech.devcoffee.integration.events.user",
  "doc": "Emitted when a user's password is changed. Never carries password or hash.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique identifier of the event (uuid)"
    },
    {
      "name": "event_version",
      "type": "int",
      "default": 1,
      "doc": "Schema version used by this event."
    },
    {
      "name": "trace_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Trace identifier for distributed tracing (uuid)"
    },
    {
      "name": "event_name",
      "type": "string",
      "default": "user.password.changed",
      "doc": "The name of the event"
    },
    {
      "name": "event_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "When the password was changed"
    },
    {
      "name": "producer",
      "type": "string",
      "doc": "Service that produced the event"
    },
    {
      "name": "data",
      "doc": "Event payload data",
      "type": {
        "type": "record",
        "name": "UserPasswordChangedData",
        "fields": [
          {
            "name": "userId",
            "type": "string",
            "doc": "User's unique identifier (uuid)"
          },
          {
            "name": "changedAt",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            },
            "doc": "When the password was changed"
          }
        ]
      }
    }
  ]
}
