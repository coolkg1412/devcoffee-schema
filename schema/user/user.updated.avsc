{
  "type": "record",
  "name": "UserUpdated",
  "namespace": "tech.devcoffee.integration.events.user",
  "doc": "Emitted when a user is updated.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique identifier of the event (uuid)"
    },
    {
      "name": "event_version",
      "type": "int",
      "default": 1,
      "doc": "Schema version used by this event."
    },
    {
      "name": "trace_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Trace identifier for distributed tracing (uuid)"
    },
    {
      "name": "event_name",
      "type": "string",
      "default": "user.updated",
      "doc": "The name of the event"
    },
    {
      "name": "event_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "When the user was updated"
    },
    {
      "name": "producer",
      "type": "string",
      "doc": "Service that produced the event"
    },
    {
      "name": "data",
      "doc": "Event payload data",
      "type": {
        "type": "record",
        "name": "UserUpdatedData",
        "fields": [
          {
            "name": "user",
            "type": {
              "type": "record",
              "name": "UpdatedUser",
              "doc": "Full snapshot of the user after the update",
              "fields": [
                {
                  "name": "id",
                  "type": "string",
                  "doc": "User's unique identifier (uuid)"
                },
                {
                  "name": "email",
                  "type": "string",
                  "doc": "User's email"
                },
                {
                  "name": "firstName",
                  "type": [
                    "null",
                    "string"
                  ],
                  "default": null,
                  "doc": "User's first name"
                },
                {
                  "name": "lastName",
                  "type": [
                    "null",
                    "string"
                  ],
                  "default": null,
                  "doc": "User's last name"
                },
                {
                  "name": "language",
                  "type": [
                    "null",
                    "string"
                  ],
                  "default": null,
                  "doc": "User's language"
                },
                {
                  "name": "timezone",
                  "type": [
                    "null",
                    "string"
                  ],
                  "default": null,
                  "doc": "User's timezone"
                },
                {
                  "name": "isActive",
                  "type": "boolean",
                  "doc": "Whether the user is active"
                },
                {
                  "name": "dateJoined",
                  "type": {
                    "type": "long",
                    "logicalType": "timestamp-millis"
                  },
                  "doc": "User's joined date"
                },
                {
                  "name": "createdAt",
                  "type": {
                    "type": "long",
                    "logicalType": "timestamp-millis"
                  },
                  "doc": "When the user was created"
                },
                {
                  "name": "updatedAt",
                  "type": {
                    "type": "long",
                    "logicalType": "timestamp-millis"
                  },
                  "doc": "When the user was last updated"
                }
              ]
            }
          },
          {
            "name": "changes",
            "doc": "Fields that changed (values stringified)",
            "type": {
              "type": "array",
              "items": {
                "type": "record",
                "name": "UserFieldChange",
                "fields": [
                  {
                    "name": "field",
                    "type": "string",
                    "doc": "Changed field name"
                  },
                  {
                    "name": "from",
                    "type": [
                      "null",
                      "string"
                    ],
                    "default": null,
                    "doc": "Previous value (stringified)"
                  },
                  {
                    "name": "to",
                    "type": [
                      "null",
                      "string"
                    ],
                    "default": null,
                    "doc": "New value (stringified)"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
